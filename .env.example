# ─── Dip-Desk Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to git.
# ────────────────────────────────────────────────────────────────────────────────

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Required. The URL of your app (use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# Required. A strong random secret string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace-with-your-own-random-secret

# ── MongoDB (Optional) ────────────────────────────────────────────────────────
# If not set, the app runs on an in-memory localStorage fallback store.
# Get a free cluster at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dipdesk

# ── Admin Credentials ─────────────────────────────────────────────────────────
# Set your own admin email and password here.
# These are used to log in at /login as Administrator.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-admin-password
